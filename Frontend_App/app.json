{
  "expo": {
    "name": "NiyamNetra",
    "slug": "niyamnetra-app",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0F2A44",
      "resizeMode": "contain"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.niyamnetra.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2A44"
      },
      "package": "com.niyamnetra.app",
      "versionCode": 6,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withCleartextTraffic",
      "./plugins/withAllowScreenCapture",
      "./plugins/withCameraTexturePreview",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAndroidAbis",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow NiyamNetra to access your camera to capture package photos for assessment."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow NiyamNetra to use your location for inspection geotagging."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow NiyamNetra to use Face ID for secure authentication."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "56e3ff95-ef31-4a56-a269-d524256d4734"
      }
    }
  }
}
